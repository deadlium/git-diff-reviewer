+import fs from 'fs';
+
+export function exportToCsv(records: Record<string, any>[], filePath: string): void {
+  if (records.length === 0) return;
+  const headers = Object.keys(records[0]).join(',');
+  const rows = records.map(r => Object.values(r).map(v => JSON.stringify(v)).join(','));
+  fs.writeFileSync(filePath, [headers, ...rows].join('\n'));
+}
